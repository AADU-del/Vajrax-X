# ========================================
# VAJRA-X Environment Configuration
# ========================================
# Copy this file to .env and fill in real values.
# The actual .env file is gitignored — NEVER commit it.
# ========================================

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me-run: python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=True

# Database (leave commented for default SQLite path)
# DATABASE_URL=sqlite:///database/vajrax.db

# Server Configuration
HOST=127.0.0.1
PORT=5000
WORKERS=1

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/vajrax.log

# AI Model
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# Redis (Optional - for production rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# OpenWeatherMap API Key — https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google Maps API Key (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Groq API Key — https://console.groq.com (free, for Vajra Copilot LLM)
GROQ_API_KEY=your_groq_api_key_here

# File Upload Limits
MAX_UPLOAD_SIZE=104857600
UPLOAD_FOLDER=static/uploads
PROCESSED_FOLDER=static/processed

# Deployment
DEPLOYMENT_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Default Admin Credentials (change before deploying!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2024!
